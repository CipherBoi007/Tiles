generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Admin User
model AdminUser {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String // Hashed
}

// Categories
model Category {
  id            Int           @id @default(autoincrement())
  name          String
  image         String
  slug          String?       @unique
  status        String        @default("active")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]

  @@index([name])
}

// SubCategories
model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String
  image      String
  slug       String?
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tiles      Tile[]

  @@index([categoryId])
  @@index([name])
}

// Tiles
model Tile {
  id            Int         @id @default(autoincrement())
  name          String
  image         String
  subCategoryId Int
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([name])
  @@index([subCategoryId])
}

// Catalogues
model Catalogue {
  id      Int      @id @default(autoincrement())
  title   String
  fileUrl String
  date    DateTime @default(now())
}

// Enquiries
model Enquiry {
  id          Int      @id @default(autoincrement())
  customer    String
  phone       String
  email       String?
  description String?
  source      String?
  status      String   @default("New") // "New", "Contacted", "Resolved"
  date        DateTime @default(now())

  @@index([status])
  @@index([date])
}

// Showroom Settings
model Setting {
  id             Int    @id @default(autoincrement())
  showroomName   String
  logoUrl        String
  whatsappNumber String
  emailAddress   String
  address        String
}

// Activity Log
model Activity {
  id    Int      @id @default(autoincrement())
  type  String
  title String
  desc  String
  time  DateTime @default(now())

  @@index([time])
}
