generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Admin User
model AdminUser {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String // Hashed
}

// Categories
model Category {
  id            Int           @id @default(autoincrement())
  name          String
  image         String
  slug          String?       @unique
  division      String?       @default("tiles") // "tiles" | "sanitaryware" | "kitchen" | "plumbing"
  status        String        @default("active")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subCategories SubCategory[]

  @@index([name])
}

// SubCategories
model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String
  image      String
  slug       String?
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tiles      Tile[]

  @@index([categoryId])
  @@index([name])
}

// Tiles
model Tile {
  id            Int         @id @default(autoincrement())
  name          String
  image         String
  subCategoryId Int
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  productCode   String?
  manufacturer  String?
  collection    String?
  size          String?
  finish        String?
  sourceUrl     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([name])
  @@index([subCategoryId])
}

// Catalogues
model Catalogue {
  id      Int      @id @default(autoincrement())
  title   String
  fileUrl String
  date    DateTime @default(now())
}

// Enquiries
model Enquiry {
  id          Int      @id @default(autoincrement())
  customer    String
  phone       String
  email       String?
  description String?
  source      String?
  status      String   @default("New") // "New", "Contacted", "Resolved"
  date        DateTime @default(now())

  @@index([status])
  @@index([date])
}

// Showroom Settings
model Setting {
  id             Int    @id @default(autoincrement())
  showroomName   String
  logoUrl        String
  whatsappNumber String
  emailAddress   String
  address        String
}

// Activity Log
model Activity {
  id    Int      @id @default(autoincrement())
  type  String
  title String
  desc  String
  time  DateTime @default(now())

  @@index([time])
}

// Catalogue Import Staging
model ExtractedProduct {
  id                    Int      @id @default(autoincrement())
  importId              String   @unique
  jobId                 String?
  manufacturer          String
  sourceUrl             String
  productCode           String?
  name                  String
  collection            String?
  size                  String?
  finish                String?
  material              String?
  color                 String?
  suggestedCategory     String?
  suggestedSubCategory  String?
  targetCategoryId      Int?
  targetSubCategoryId   Int?
  primaryImageUrl       String
  galleryImages         String?  // JSON string array
  imageStatus           String   @default("valid") // "valid" | "invalid" | "pending"
  imageError            String?
  duplicateStatus       String   @default("unique") // "unique" | "exact_duplicate" | "potential_duplicate"
  reviewStatus          String   @default("pending_review") // "pending_review" | "approved" | "rejected" | "imported"
  validationWarnings    String?  // JSON string array
  importedTileId        Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([manufacturer])
  @@index([reviewStatus])
  @@index([jobId])
}

// Extraction Jobs Tracking
model ImportJob {
  id              String    @id @default(uuid())
  manufacturer    String    // "Italake" | "Itaca" | "both"
  status          String    @default("pending") // "pending" | "running" | "completed" | "failed" | "cancelled"
  pagesDiscovered Int       @default(0)
  pagesProcessed  Int       @default(0)
  productsFound   Int       @default(0)
  validImages     Int       @default(0)
  invalidImages   Int       @default(0)
  duplicateCount  Int       @default(0)
  errorDetails    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
}

